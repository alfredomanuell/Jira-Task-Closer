{
  "manifest_version": 3,
  "name": "Jira Task Closer",
  "version": "1.0.0",
  "description": "Lista as tuas tarefas abertas no Jira e fecha-as com um clique.",
  "permissions": ["storage", "activeTab", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jira Task Closer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
